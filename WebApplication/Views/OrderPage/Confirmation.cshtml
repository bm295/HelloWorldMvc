@model OrderConfirmationViewModel
@{
    ViewData["Title"] = "Order Confirmed";
}

<main class="confirmation-shell">
    <section class="confirmation-card">
        <p class="eyebrow">Order Confirmed</p>
        <h1>Order #@Model.OrderId is recorded.</h1>
        <p class="hero-copy">
            Customer <strong>@Model.Customer</strong> was captured on @Model.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm").
        </p>

        <div class="confirmation-list">
            @foreach (var item in Model.Items)
            {
                <div class="confirmation-row">
                    <span>@item.Name</span>
                    <strong>x @item.Quantity</strong>
                </div>
            }
        </div>

        <div class="confirmation-actions">
            <a class="submit-button" asp-action="Index">Create another order</a>
            <a class="ghost-link" href="/api/orders/@Model.OrderId">Open API record</a>
        </div>
    </section>
</main>
