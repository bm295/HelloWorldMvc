@model OrderPageViewModel
@{
    ViewData["Title"] = "Place Order";
    var availableItems = Model.Items.Count(item => item.AvailableQuantity > 0);
    var canSubmit = availableItems > 0;
    var totalStock = Model.Items.Sum(item => item.AvailableQuantity);
}

<main class="page-shell">
    <section class="hero-panel">
        <p class="eyebrow">MilkCO FnB Management</p>
        <h1>Capture orders with the current stock snapshot.</h1>
        <p class="hero-copy">
            This order screen keeps service fast while preserving the backend rules for inventory deduction and stock validation.
        </p>

        <div class="metric-grid">
            <article>
                <span class="metric-label">Orderable items</span>
                <strong>@availableItems</strong>
            </article>
            <article>
                <span class="metric-label">Units in stock</span>
                <strong>@totalStock</strong>
            </article>
        </div>

        <div class="hero-note">
            <h2>Business-case alignment</h2>
            <p>Centralized order capture is now available from the web app and still routes through the existing order service.</p>
        </div>
    </section>

    <section class="form-panel">
        <div class="panel-header">
            <div>
                <p class="eyebrow">New Order</p>
                <h2>Place an order</h2>
            </div>
            <a class="ghost-link" href="/api/orders">Orders API</a>
        </div>

        <form asp-action="Index" method="post" class="order-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <label class="field-block" asp-for="Customer">
                <span>Customer name</span>
                <input asp-for="Customer" placeholder="e.g. Table 12 / Nguyen family" />
                <span asp-validation-for="Customer" class="field-error"></span>
            </label>

            <label class="field-block" asp-for="TableId">
                <span>Table</span>
                <select asp-for="TableId" asp-items="@(new SelectList(Model.Tables, "TableId", "Name"))"></select>
                <span asp-validation-for="TableId" class="field-error"></span>
            </label>

            <div class="inventory-header">
                <div>
                    <p class="section-kicker">Inventory lines</p>
                    <h3>Select quantities to submit</h3>
                </div>
                <span class="stock-chip">Live validation on submit</span>
            </div>

            @if (Model.Items.Count == 0)
            {
                <div class="empty-state">
                    <h3>No inventory records yet</h3>
                    <p>Add inventory items through the API before using the order page.</p>
                </div>
            }
            else
            {
                <div class="inventory-grid">
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var item = Model.Items[i];
                        var isOutOfStock = item.AvailableQuantity <= 0;
                        var cardClass = isOutOfStock ? "inventory-card is-empty" : "inventory-card";
                        var maxQuantity = Math.Max(0, item.AvailableQuantity);

                        <article class="@cardClass">
                            <input asp-for="Items[i].InventoryItemId" type="hidden" />
                            <input asp-for="Items[i].Name" type="hidden" />
                            <input asp-for="Items[i].AvailableQuantity" type="hidden" />

                            <div class="inventory-meta">
                                <div>
                                    <h4>@item.Name</h4>
                                    <p>@(isOutOfStock ? "Temporarily unavailable" : "Ready to order")</p>
                                </div>
                                <span class="stock-badge">Stock: @item.AvailableQuantity</span>
                            </div>

                            <label asp-for="Items[i].RequestedQuantity" class="quantity-field">
                                <span>Quantity</span>
                                @if (isOutOfStock)
                                {
                                    <input asp-for="Items[i].RequestedQuantity"
                                           type="number"
                                           min="0"
                                           max="@maxQuantity"
                                           disabled />
                                }
                                else
                                {
                                    <input asp-for="Items[i].RequestedQuantity"
                                           type="number"
                                           min="0"
                                           max="@maxQuantity" />
                                }
                            </label>
                        </article>
                    }
                </div>
            }

            @if (!canSubmit)
            {
                <p class="stock-warning">No stock is currently available for ordering.</p>
            }

            @if (canSubmit)
            {
                <button type="submit" class="submit-button">Place order</button>
            }
            else
            {
                <button type="submit" class="submit-button" disabled>Place order</button>
            }
        </form>
    </section>
</main>
